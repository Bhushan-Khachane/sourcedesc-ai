# ── App ──────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production
DEBUG=true

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://sourcedesc:sourcedesc@localhost:5432/sourcedesc
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider (azure_openai | openai | ollama) ────────────────
LLM_PROVIDER=azure_openai

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT_TABLE=gpt-4o
AZURE_OPENAI_DEPLOYMENT_COLUMN=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# OpenAI (if using direct OpenAI)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_TABLE=gpt-4o
OPENAI_MODEL_COLUMN=gpt-4o-mini

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Secrets Backend (keyvault | awssecrets | env) ────────────────
SECRETS_BACKEND=env
AZURE_KEY_VAULT_NAME=your-keyvault-name
AWS_REGION=us-east-1

# ── Microsoft Purview ────────────────────────────────────────────
PURVIEW_ACCOUNT_NAME=your-purview-account
PURVIEW_GLOSSARY_GUID=your-default-glossary-guid

# ── Databricks Unity Catalog ─────────────────────────────────────
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
DATABRICKS_WAREHOUSE_ID=your-sql-warehouse-id
DATABRICKS_DEFAULT_CATALOG=main

# ── Sampling ─────────────────────────────────────────────────────
DEFAULT_SAMPLE_SIZE=100
PII_AWARE_SAMPLING=true
MAX_COLUMNS_PER_LLM_CALL=50

# ── Auth ─────────────────────────────────────────────────────────
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
